{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": [".node-version", "pnpm-workspace.yaml"],
  "noUpdateNotifier": true,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test-bench": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["BENCHER_OUTPUT_DIR"],
      "inputs": ["benchmarks/**", "package.json", "tsconfig.json"]
    },
    "test-coverage": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "lint-publish": {
      "dependsOn": ["build"]
    },
    "pre-commit": {},
    "pre-push": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@zemd/react-modals#typecheck": {
      "dependsOn": ["build", "^build"],
      "inputs": ["benchmarks/**", "src/**", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "@zemd/react-slottable#typecheck": {
      "dependsOn": ["build", "^build"],
      "inputs": ["benchmarks/**", "src/**", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
